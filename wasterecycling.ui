      <property name="styleSheet">
       <string notr="true">QFrame#clframe_2 {
    background-color: #25665A;
    border-radius: 80px;
}

QListWidget {
    background-color: white;
    border-radius: 14px;
    border: none;
    font-size: 14px;
    color: #000000;
    padding: 6px;
}
QListWidget::item {
    padding: 10px;
    border-bottom: 1px solid #f0f0f0;
}
QListWidget::item:selected {
    background-color: #ECF5E9;
    color: #25665A;
    font-weight: bold;
}
QListWidget::item:hover {
    background-color: #f5f5f5;
}

QTextEdit {
    background-color: white;
    border: none;
    border-radius: 14px;
    font-size: 14px;
    color: #000000;
    padding: 10px;
}

QLabel {
    background-color: transparent;
    color: white;
    border: none;
    font-size: 14px;
    font-weight: bold;
}

QPushButton {
    background-color: white;
    color: #000000;
    border: 2px solid #245F4E;
    border-radius: 18px;
    padding: 8px 18px;
    font-size: 14px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #F2F7F5;
}
QPushButton:disabled {
    background-color: #cccccc;
    color: #888888;
    border-color: #aaaaaa;
}
</string>
