        <property name="styleSheet">
         <string notr="true">QFrame#empTableFrame{
 background-color:rgba(236, 245, 233,255);
 border-radius:40px;
}
QLabel{
 color:black;
 background-color: transparent;
 font-weight:bold;
}

QPushButton {
    border: none;
    background: none;
	opacity: 0.5;
}
QPushButton:hover {
    /* optional hover effect */
    opacity: 1;
}
QPushButton:pressed {
    padding-top: 6px;
}

QTableView {
    background-color: rgb(37, 102, 90);
    border: none;
    font-size: 12px;
    selection-background-color: rgb(185, 244, 156);
    gridline-color: rgba(255, 255, 255, 0.15);
    border-radius: 12px;
}

QHeaderView::section {
    background-color: #36656B;
    color: white;
    padding: 10px;
    border: none;
    font-weight: bold;
    font-size: 12px;
    border-radius: 0px;
}

QHeaderView::section:first {
    border-top-left-radius: 12px;
}

QHeaderView::section:last {
    border-top-right-radius: 12px;
}

QTableView::item {
    padding: 8px;
    color: white;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

QTableView::item:selected {
    background-color: #75B06F;
    color: white;
}

QTableView::item:alternate {
    background-color: rgba(255, 255, 255, 0.05);
}</string>
