       <string notr="true">/* ================= GLOBAL STYLES ================= */
QMainWindow {
    background-color: #F4F6F5;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    color: #1F2D2B;
    font-size: 10pt;
}

QWidget {
    color: #1F2D2B;
}

/* ================= LABELS ================= */
QLabel {
    color: #1F2D2B;
}

/* ================== LEFT PANEL ================== */
#GCont_leftPanel, #GCont_headerWidget, QWidget[leftPanel=&quot;true&quot;] {
    background-color: #EEF7EC;
    border-radius: 20px;
}

/* ================== RIGHT MAIN PANEL ================== */
#GCont_rightPanel {
    background-color: #245F52;
    border-radius: 28px;
}

/* FIX: Ensure labels in right panel have white text */
#GCont_rightPanel QLabel {
    color: #FFFFFF;
}

#GCont_rightPanel QGroupBox {
    background-color: #FFFFFF;
    border-radius: 20px;
    border: none;
    margin-top: 16px;
    padding: 16px;
}

/* FIX: Ensure group box titles in right panel are visible */
#GCont_rightPanel QGroupBox::title {
    color: #245F52;
    font-weight: bold;
}

/* ================== WHITE CARDS ================== */
QGroupBox {
    background-color: #FFFFFF;
    border-radius: 20px;
    border: none;
    margin-top: 16px;
    padding: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 20px;
    padding: 0 8px;
    font-weight: bold;
    color: #245F52;
}

/* ================== INPUTS ================== */
QLineEdit, QComboBox, QSpinBox, QDateEdit {
    background-color: #FFFFFF;
    border-radius: 12px;
    border: 1px solid #D6E5DD;
    padding: 10px;
    color: #1F2D2B;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus {
    border: 2px solid #1F6B5B;
}

QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #1F2D2B;
    border-radius: 14px;
    padding: 10px;
}

/* ================== BUTTONS ================== */
QPushButton {
    color: #1d4a43;
    background-color: #ffffff;
    font-family: &quot;Segoe&quot;, sans-serif;
    font-size: 11pt;
    font-weight: bold;
    border-radius: 20px;
    padding: 12px 18px;
    border: none;
}

QPushButton:hover {
    color: #060504;
    background-color: #bdf7a3;
}

QPushButton:pressed {
    color: #060504;
    background-color: rgb(99, 129, 85);
}

/* ================== TABLE VIEW ================== */
QTableView {
    background-color: #FFFFFF;
    border-radius: 18px;
    border: none;
    gridline-color: transparent;
}

QHeaderView::section {
    background-color: #245F52;
    color: white;
    padding: 10px;
    border: none;
    font-weight: bold;
}

QTableView::item {
    padding: 10px;
}

QTableView::item:selected {
    background-color: #DFF2EA;
    color: #1F2D2B;
}

/* ================== SEARCH BAR ================== */
QLineEdit[placeholderText] {
    background-color: #FFFFFF;
}

/* ================== STATUS BAR ================== */
QStatusBar {
    background-color: #FFFFFF;
    color: #245F52;
    border-top: 1px solid #D6E5DD;
}

/* ================== DARK PANELS ================== */
QWidget[darkPanel=&quot;true&quot;] {
    background-color: #245F52;
    color: #FFFFFF;
    border-radius: 24px;
}

QWidget[darkPanel=&quot;true&quot;] QLabel,
QWidget[darkPanel=&quot;true&quot;] QPushButton,
QWidget[darkPanel=&quot;true&quot;] QGroupBox::title {
    color: #FFFFFF;
}

/* ================= PREVIEW / ANALYSIS BOX ================= */
QTextEdit#GCont_previewText,
QPlainTextEdit#GCont_previewText {
    background-color: #1B4F72;
    border: 1px solid #2980B9;
    color: #D6EAF8;
}

/* ================== SPECIFIC WIDGET STYLES ================== */
#GCont_iconLabel {
    font-size: 28px;
    color: #27AE60;
}

#GCont_titleLabel {
    font-size: 22px;
    font-weight: bold;
    color: #3498DB;
}

#GCont_userLabel {
    font-size: 14px;
    color: #ECF0F1;
    padding: 8px 16px;
    background-color: #27AE60;
    border-radius: 10px;
    font-weight: bold;
}

#GCont_sortButton, #GCont_searchButton, #GCont_refreshButton,
#GCont_addButton, #GCont_updateButton, #GCont_deleteButton,
#GCont_clearButton, #GCont_previewButton {
    color: #1d4a43;
    background-color: #ffffff;
    padding: 12px 18px;
    font-size: 11pt;
}

#GCont_totalContainersLabel, #GCont_normalStatusLabel, #GCont_warningLabel, #GCont_criticalLabel,
#GCont_totalContainersValue, #GCont_normalStatusValue {
    color: #1F2D2B;
}

#GCont_warningValue {
    font-weight: bold;
    font-size: 16px;
    color: #F39C12;
}

#GCont_criticalValue {
    font-weight: bold;
    font-size: 16px;
    color: #E74C3C;
}

#GCont_lastUpdateLabel {
    font-style: italic;
    color: #BDC3C7;
    margin-top: 10px;
}

#GCont_aiPredictionText {
    background-color: #17202A;
    border: 1px solid #F39C12;
    color: #FDEBD0;
}

#GCont_previewLabel {
    color: #3498DB;
    font-weight: bold;
}

#GCont_previewText {
    background-color: #1B4F72;
    border: 1px solid #2980B9;
    color: #D6EAF8;
}

#GCont_statusbar {
    color: #BDC3C7;
}

/* ================= PROGRESS BAR STYLES ================= */
QProgressBar {
    border: 1px solid #27AE60;
    border-radius: 3px;
    background-color: #34495E;
    color: #ECF0F1;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #2ECC71;
    border-radius: 2px;
}

QProgressBar[dark=&quot;true&quot;] {
    border: 1px solid #C0392B;
}

QProgressBar[dark=&quot;true&quot;]::chunk {
    background-color: #E74C3C;
}

QProgressBar[warning=&quot;true&quot;] {
    border: 1px solid #D35400;
}

QProgressBar[warning=&quot;true&quot;]::chunk {
    background-color: #f39c12;
}

/* ================= FIX FOR MESSAGE BOXES ================= */
QMessageBox {
    background-color: #FFFFFF;
    color: #1F2D2B;
}

QMessageBox QLabel {
    color: #1F2D2B;
    background-color: transparent;
    font-size: 11pt;
}

QMessageBox QPushButton {
    color: #1d4a43;
    background-color: #ffffff;
    font-family: &quot;Segoe&quot;, sans-serif;
    font-size: 11pt;
    font-weight: bold;
    border-radius: 20px;
    padding: 8px 16px;
    min-width: 80px;
    border: none;
}

QMessageBox QPushButton:hover {
    color: #060504;
    background-color: #bdf7a3;
}

QMessageBox QPushButton:pressed {
    color: #060504;
    background-color: rgb(99, 129, 85);
}

/* ================= FIX FOR COMBOBOX POPUP ================= */
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1F2D2B;
    border: 1px solid #D6E5DD;
    selection-background-color: #bdf7a3;
    selection-color: #1d4a43;
    outline: none;
}

QComboBox QAbstractItemView::item {
    color: #1F2D2B;
    padding: 8px;
    min-height: 20px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #bdf7a3;
    color: #060504;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #bdf7a3;
    color: #1d4a43;
}

/* ================= FIX FOR COMBOBOX IN RIGHT PANEL ================= */
#GCont_rightPanel QComboBox {
    background-color: #FFFFFF;
    color: #1F2D2B;
}

#GCont_rightPanel QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1F2D2B;
}
QGroupBox{
background-color:#ECF5E9;
border-radius:30px;
}
QTableView::item {
    background-color: transparent;
}

QTableView::item:selected:!active {
    background: #ECF5E9;
}
QTableView {
    selection-background-color: #ECF5E9;
    selection-color: black;
	border-radius:30px;
}

QTableView::item:selected {
    background-color: #ECF5E9;
    color: black;
}

QTableView::item:selected:active {
    background-color: #ECF5E9;
    color: black;
}

QTableView::item:selected:!active {
    background-color: #ECF5E9;
    color: black;
}
QTableCornerButton{
	background-color: #25665A;
}
QLabel#GCont_userLabel {
    background-color: #25665A;
}
QGroupBox#GCont_actionBox{
	background-color: #25665A;
}
/* GROUPBOX */
QGroupBox {
    background-color: #DCE7D9;   /* soft green background */
    border: none;
    border-radius: 15px;
    margin-top: 10px;
}

/* INPUT FIELDS */
QLineEdit,
QSpinBox,
QDateEdit,
QComboBox,
QTextEdit {
    background-color: #FFFFFF;     /* pure white for clarity */
    border: 1px solid #B7CDB5;     /* soft green border */
    border-radius: 10px;
    padding: 6px;
    color: #1E1E1E;                /* dark text */
    font-size: 14px;
}

/* Focus effect */
QLineEdit:focus,
QSpinBox:focus,
QDateEdit:focus,
QComboBox:focus,
QTextEdit:focus {
    border: 2px solid #6FAF8D;     /* stronger green when active */
}
QPushButton{
 background:#ECF5E9;
 border-radius:12px;
 padding:6px;
 font-size:13px;
 font-weight:bold;
    padding-top: 10px;
    padding-bottom: 10px;
}
QPushButton:hover{
 background:#D6EAD6;
