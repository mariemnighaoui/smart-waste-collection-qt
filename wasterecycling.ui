}
QPushButton{
 background-color: rgba(236, 245, 233, 255);
 color: black;
 border-radius:14px;
 padding:10px;
}
QPushButton:hover{
 border:2px solid black;
}
QLineEdit:hover{
 border:2px solid black;

}
QComboBox:hover {
	border: 2px solid black;
}
QLineEdit:focus {
    border: 2px solid black;
	background: rgba(236, 245, 233, 255);
     border-radius:25px;
}
QComboBox:focus {
    border: 2px solid black;

}
QPushButton:pressed {
    padding-top: 12px;
    padding-left: 12px;
	background-color: #baf49c;
	outline: none;
}
QComboBox::drop-down {
    border: none;
    width: 30px;
}
QComboBox::down-arrow {
    image: none;
    width: 10px;
    height: 10px;
    border-left: 2px solid #36656B;
    border-bottom: 2px solid #36656B;
    transform: rotate(-45deg);
    margin-right: 12px;
}
QComboBox QAbstractItemView {
    background-color: rgba(236, 245, 233,255);
    border: 2px solid black;
    selection-background-color: rgba(236, 245, 233,255);
    selection-color: rgba(37, 102, 90, 255);
    padding: 10px;
	border-radius: 10px;
	margin-top: 6px;
}
QComboBox QAbstractItemView:hover{
	border: 2px solid black
}</string>
