         <property name="styleSheet">
          <string notr="true">QTableView {
    background-color: white;
    border: 1px solid #FAF7F2;
    border-radius: 6px;
    gridline-color: #FAF7F2;
    font-size: 14px;
    color: #333333;
}

/* Header encore plus clair */
QHeaderView::section {
    background-color: #F8F4ED;
    color: #333333;
    font-weight: bold;
    font-size: 14px;
    padding: 4px;
    border: none;
}

/* Cellules */
QTableView::item {
    background-color: white;
    padding: 4px;
}

/* Lignes alternées très légères */
QTableView::item:alternate {
    background-color: #FAF7F2;
}

/* Sélection douce (pas agressive) */
QTableView::item:selected {
    background-color: #EFE8DA;
    color: #222222;
}

/* Cacher les scrollbars */
QTableView QScrollBar:horizontal,
QTableView QScrollBar:vertical {
    width: 0px;
    height: 0px;
}
</string>
