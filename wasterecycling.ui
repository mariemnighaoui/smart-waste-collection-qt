      <property name="styleSheet">
       <string notr="true">/* ===== GLOBAL ===== */
QWidget {
    font-family: &quot;Segoe UI&quot;;
    font-size: 12pt;
    color: #1f2937;
    background: #ffffff;
}


/* ===== TITLE ===== */
QLabel#GPC_Title {
    font-size: 22pt;
    font-weight: 800;
    color: #ffffff;
}

/* ===== INPUTS ===== */
QLineEdit#GPC_TxtSearch {
    background: white;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 10px 14px;
}
QLineEdit#GPC_TxtSearch:focus { border: 1px solid #2f7d7a; }

/* ===== COMBOBOX ===== */
QComboBox {
    background: white;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 8px 12px;
}
QComboBox::drop-down { border: 0px; width: 30px; }
QComboBox QAbstractItemView {
    background: white;
    border: 1px solid #d1d5db;
    selection-background-color: #cfe9e8;
    selection-color: #111827;
}

/* ===== BUTTONS ===== */
QPushButton {
    background: white;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 10px 16px;
    font-weight: 600;
}
QPushButton:hover { background: #f3f4f6; }
QPushButton:pressed { background: #e5e7eb; }
QPushButton:disabled { color: #9ca3af; background:#f9fafb; }

/* Primary */
QPushButton#GPC_BtnReset,
QPushButton#GPC_BtnStats {
    background: #2f7d7a;
    color: white;
    border: 1px solid #2a6f6c;
}
QPushButton#GPC_BtnReset:hover,
QPushButton#GPC_BtnStats:hover { background: #2a6f6c; }

/* ===== TABLE ===== */
QTableWidget#GPC_TablePoints {
    background: white;
    border: 1px solid #d1d5db;
    gridline-color: #e5e7eb;
    alternate-background-color: #fafafa;
    selection-background-color: #cfe9e8;
    selection-color: #111827;
}

/* cells */
QTableWidget#GPC_TablePoints::item {
    padding: 14px 12px;
    border-bottom: 1px solid #edf0f2;
}

/* header green */
QHeaderView::section {
    background-color: rgba(37, 102, 90, 255);;
    color: white;
    padding: 14px 10px;
    border: 1px solid #2a6f6c;
    font-weight: 800;
    font-size: 11pt;
}

QTableCornerButton::section {
    background-color: #2f7d7a;
    border: 1px solid #2a6f6c;
}

/* ===== SPINBOX : style propre, flèches NATIVES ===== */
QAbstractSpinBox {
    background: white;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 6px 10px;          /* pas de padding-right spécial */
}

QAbstractSpinBox:focus {
    border: 1px solid #2f7d7a;
}
</string>
      </property>
